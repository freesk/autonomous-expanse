; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DroneWorld"
config/description="A 3D drone game featuring cargo drones, explorer drones, fighters, and motherships"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

LoadingManager="*res://src/autoloads/loading_manager.gd"
AIDebugLogger="*res://src/autoloads/ai_debug_logger.gd"
UIManager="*res://src/ui/ui_manager.gd"
FactionManager="*res://src/autoloads/faction_manager.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

